# News admin configuration
#
# The News admin password is verified SERVER-SIDE and is never sent to the
# browser, so it must NOT be committed here. .env files are gitignored and
# .env.example is committed with placeholders only.
#
# Local development:
#   cp .env.example .env   (or just export the variables before `npm run dev`)
#
# Production (Cloudflare Workers):
#   npx wrangler secret put ADMIN_USERNAME
#   npx wrangler secret put ADMIN_PASSWORD
#
# The session cookie is signed with ADMIN_SESSION_SECRET when it is set,
# otherwise the key is derived from ADMIN_PASSWORD. Setting it separately
# means changing the password does not invalidate existing sessions.
#
# Values below are placeholders and are NOT used as real credentials.

ADMIN_USERNAME=fikrado
ADMIN_PASSWORD=CHANGE_ME

# Optional but recommended. Any long random string.
# ADMIN_SESSION_SECRET=CHANGE_ME