# Copy to `.env` and fill in real values locally. `.env` is gitignored.
#
# Only NON-`VITE_` names belong here. The Vite config injects every `VITE_*`
# variable into the CLIENT bundle, so anything prefixed `VITE_` is public.
# Admin credentials below are read server-side only.

# REQUIRED. Password for the News admin area. No default — login stays closed
# until this is set. Never commit a real value.
ADMIN_PASSWORD=

# OPTIONAL. Admin username. Defaults to `fikrado` when unset.
ADMIN_USERNAME=fikrado

# OPTIONAL. HMAC key used to sign the News admin session cookie.
# When unset, a key is derived from ADMIN_PASSWORD, so sessions are
# invalidated by a password change. Set an explicit long random value in
# production so you can rotate the password without logging everyone out.
# Generate one with:  openssl rand -hex 32
ADMIN_SESSION_SECRET=

# OPTIONAL. Absolute origin of the deployed site, e.g. https://fikrado2.github.io
# Used as an extra allow-listed origin for admin state-changing requests.
PUBLIC_APP_ORIGIN=